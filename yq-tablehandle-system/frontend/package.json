{
  "name": "yq-tablehandle-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.js && cd ../exports/config-json-offline && zip -q ../config-json-offline.zip index.html parser.js app.js"
  },
  "dependencies": {
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.31.0",
    "quickjs-emscripten-core": "^0.31.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.7.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
