{
  "name": "pangu-plugin-tablehandle",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "webpack serve --config webpack.dev.cjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && webpack --config webpack.prod.cjs",
    "build:preview": "vite build --outDir dist-preview",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.js && cd ../exports/config-json-offline && zip -q ../config-json-offline.zip index.html parser.js app.js"
  },
  "dependencies": {
    "@ant-design/icons": "4.8.1",
    "@jitl/quickjs-singlefile-browser-release-sync": "^0.31.0",
    "@pangu/plugin-sdk": "0.14.0",
    "antd": "4.23.4",
    "moment": "2.30.1",
    "quickjs-emscripten-core": "^0.31.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "react-router-dom": "5.3.4"
  },
  "devDependencies": {
    "@pangu/plugin-webpack-preset": "0.19.2",
    "@types/react": "17.0.76",
    "@types/react-dom": "17.0.15",
    "@types/react-router-dom": "^5.3.3",
    "autoprefixer": "^10.7.0",
    "esbuild": "0.28.2",
    "less": "^4.2.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vite": "^7.2.0"
  }
}
